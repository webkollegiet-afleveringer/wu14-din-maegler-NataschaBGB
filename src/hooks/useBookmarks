import { useState, useEffect } from "react";

export function useBookmarks() {
    const [bookmarked, setBookmarked] = useState(() => {
    return JSON.parse(localStorage.getItem("saved_homes")) || [];
});

  useEffect(() => {
    localStorage.setItem("saved_homes", JSON.stringify(bookmarked));
  }, [bookmarked]);

  const isBookmarked = (id) => bookmarked.some((a) => a.id === id);

  const addBookmark = (id, adress1, description) => {
    if (isBookmarked(id)) return;

    // change to match the home data structure
    const newHome = {
      id: id,
      headline: adress1,
      text: description,
      buttonPressed: true,
    };

    setBookmarked((prev) => [...prev, newHome]);
  };


  const removeBookmark = (id) => {
    setBookmarked((prev) => prev.filter((a) => a.id !== id));
  };

  return { bookmarked, addBookmark, removeBookmark, isBookmarked };
}